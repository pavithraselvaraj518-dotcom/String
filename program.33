#include <stdio.h>

int main() {
    char str[100];
    int i = 0, count = 0;

    printf("Enter a string: ");
    scanf("%s", str);

    while (str[i] != '\0') {
        if (str[i] >= 'a' && str[i] <= 'z')
            count++;
        i++;
    }

    printf("Lowercase Letters = %d", count);

    return 0;
}
